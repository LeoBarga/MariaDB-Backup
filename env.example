# Rinominare in .env  (es. /opt/mariadb-backup/.env)
# Permessi obbligatori (lo script si rifiuta di partire altrimenti):
#   sudo chown root:dbbackup /opt/mariadb-backup/.env && sudo chmod 640 /opt/mariadb-backup/.env
# I valori di questo file hanno la precedenza sulle variabili d'ambiente.

# --- Controllo accessi ---
# Unico utente di sistema autorizzato a eseguire lo script (root compreso viene rifiutato).
RUN_AS_USER=dbbackup

# --- Autenticazione ---
# socket   = CONSIGLIATA. Connessione locale via socket Unix con plugin unix_socket:
#            l'utente MariaDB è l'utente di sistema che esegue lo script, nessuna password.
# password = solo se il database è su un altro host.
AUTH_MODE=socket

# Usati con AUTH_MODE=socket
DB_SOCKET=/run/mysqld/mysqld.sock
# DB_USER è facoltativo: di default è l'utente di sistema che esegue lo script
# (con unix_socket deve coincidere con quello).
#DB_USER=dbbackup   # deve coincidere con RUN_AS_USER

# Usati con AUTH_MODE=password (lasciare commentati in modalità socket:
# con AUTH_MODE=socket lo script rifiuta di partire se DB_PASSWORD è impostata)
#DB_HOST=db.example.local
#DB_PORT=3306
#DB_USER=backup
#DB_PASSWORD="cambiami"

DB_NAME=mio_database

# --- Crittografia dei backup ---
# Dump e binlog vengono cifrati con age verso le chiavi PUBBLICHE elencate nel file
# (una per riga, formato age1...). La chiave privata NON deve stare su questo server.
# Il file deve essere di root e non scrivibile da altri:
#   sudo chown root:root /opt/mariadb-backup/recipients.txt && sudo chmod 644 /opt/mariadb-backup/recipients.txt
ENCRYPTION_ENABLED=true
AGE_RECIPIENTS_FILE=/opt/mariadb-backup/recipients.txt
#AGE_BIN=/usr/bin/age

# --- Destinazione e rotazione ---
BACKUP_DIR=/var/backups/mariadb
MAX_BACKUPS=5

# --- Binary log (point-in-time recovery) ---
BINLOG_ENABLED=true
# Giorni di binlog archiviati da conservare.
# Deve essere >= MAX_BACKUPS (con dump giornalieri) per coprire anche il dump più vecchio.
BINLOG_RETENTION_DAYS=7
# Se true, dopo un'archiviazione riuscita elimina dal server i binlog più vecchi di N giorni
PURGE_SERVER_BINLOGS=false
SERVER_BINLOG_KEEP_DAYS=3

# --- Varie ---
LOG_FILE=/var/log/mariadb-backup/backup.log
# Spazio minimo libero richiesto prima di scrivere (0 = disabilita il controllo)
MIN_FREE_MB=1024
# Orario del backup in modalità --daemon (APScheduler), ora locale
SCHEDULE_TIME=02:15

# Opzioni aggiuntive per mysqldump (es. --ignore-table=mio_database.log_table)
#DUMP_EXTRA_ARGS=

# Percorsi espliciti dei client (di default: mariadb-dump/mysqldump, mariadb/mysql, mariadb-binlog/mysqlbinlog)
#MYSQLDUMP_BIN=/usr/bin/mariadb-dump
#MYSQL_BIN=/usr/bin/mariadb
#MYSQLBINLOG_BIN=/usr/bin/mariadb-binlog