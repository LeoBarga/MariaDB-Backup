# --- Connessione al database ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=mio_database
DB_USER=backup
DB_PASSWORD="cambiami"

# --- Destinazione e rotazione ---
BACKUP_DIR=/var/backups/mariadb
MAX_BACKUPS=5

# --- Binary log (point-in-time recovery) ---
BINLOG_ENABLED=true
# Giorni di binlog archiviati da conservare.
# Deve essere >= MAX_BACKUPS (con dump giornalieri) per coprire anche il dump più vecchio.
BINLOG_RETENTION_DAYS=7
# Se true, dopo un'archiviazione riuscita elimina dal server i binlog più vecchi di N giorni
PURGE_SERVER_BINLOGS=false
SERVER_BINLOG_KEEP_DAYS=3

# --- Varie ---
LOG_FILE=/var/log/mariadb-backup/backup.log
# Spazio minimo libero richiesto prima di scrivere (0 = disabilita il controllo)
MIN_FREE_MB=1024
# Orario del backup in modalità --daemon (APScheduler), ora locale
SCHEDULE_TIME=02:15

# Opzioni aggiuntive per mysqldump (es. --ignore-table=mio_database.log_table)
#DUMP_EXTRA_ARGS=

# Percorsi espliciti dei client (di default: mariadb-dump/mysqldump, mariadb/mysql, mariadb-binlog/mysqlbinlog)
#MYSQLDUMP_BIN=/usr/bin/mariadb-dump
#MYSQL_BIN=/usr/bin/mariadb
#MYSQLBINLOG_BIN=/usr/bin/mariadb-binlog
